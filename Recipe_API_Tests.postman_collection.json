{
  "info": {
    "name": "Recipe API - Manufacturing Module (v1)",
    "description": "Complete test suite for Recipe Management APIs with API versioning (v1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Ingredient (Prerequisite)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Paracetamol Powder\",\n  \"description\": \"Active pharmaceutical ingredient for pain relief\",\n  \"unit\": \"G\",\n  \"currentStock\": 5000.00,\n  \"thresholdLow\": 500.00,\n  \"thresholdHigh\": 10000.00,\n  \"costPerUnit\": 2.50\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/ingredients",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "ingredients"]
        }
      }
    },
    {
      "name": "2. Create Recipe - Basic Syrup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipeCode\": \"SYR001\",\n  \"name\": \"Paracetamol Syrup 120mg/5ml\",\n  \"category\": \"SYRUP\",\n  \"subCategory\": \"Analgesic\",\n  \"description\": \"Paracetamol syrup for fever and pain relief\",\n  \"outputQuantity\": 1000,\n  \"outputUnit\": \"ML\",\n  \"wastagePercent\": 3.0,\n  \"fixedProductionCost\": 50,\n  \"variableProductionCost\": 20,\n  \"isActive\": true,\n  \"status\": \"DRAFT\",\n  \"ingredients\": [\n    {\n      \"ingredientId\": 1,\n      \"quantityRequired\": 50.0,\n      \"unit\": \"G\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/recipes",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "recipes"]
        }
      }
    },
