{
  "id": "railway-production-env",
  "name": "Pharmacy API - Railway Production",
  "values": [
    {
      "key": "base_url",
      "value": "https://YOUR-RAILWAY-DOMAIN.railway.app",
      "type": "default",
      "enabled": true
    },
    {
      "key": "api_version",
      "value": "v1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "full_api_url",
      "value": "{{base_url}}/api/{{api_version}}",
      "type": "default",
      "enabled": true
    },
    {
      "key": "health_check",
      "value": "{{base_url}}/actuator/health",
      "type": "default",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}

