# Railway Deployment Configuration
LOGGING_LEVEL_COM_PHARMACY=INFO
LOGGING_LEVEL_ROOT=WARN
# Logging (Reduce logging overhead)

SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=20000
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
# Connection Pool (HikariCP) - Reduce for low memory

SPRING_MAIN_LAZY_INITIALIZATION=true
# Lazy Initialization

SPRING_DEVTOOLS_ENABLED=false
MANAGEMENT_METRICS_EXPORT_OTLP_ENABLED=false
MANAGEMENT_TRACING_ENABLED=false
# Disable Unnecessary Features

SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# JPA Configuration for Production

SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_URL=${DATABASE_URL}
# Database Configuration (use Railway PostgreSQL)

SERVER_PORT=8080
# Server Configuration

SPRING_PROFILES_ACTIVE=railway
# Spring Boot Production Profile

JAVA_OPTS=-Xms128m -Xmx384m -XX:MaxMetaspaceSize=128m -XX:+UseG1GC -XX:MaxGCPauseMillis=100 -XX:+UseStringDeduplication -Djava.security.egd=file:/dev/./urandom
# JVM Memory Settings (Critical for Railway Free Tier - 512MB RAM)


